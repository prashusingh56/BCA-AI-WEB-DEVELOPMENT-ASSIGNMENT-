<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Webpage</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6fa;
            color: #333;
            line-height: 1.6;
        }

        header {
            background: #263b80;
            color: white;
            padding: 20px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        header h1 {
            font-size: 25px;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        nav a {
            color: white;
            text-decoration: none;
        }

        nav a:hover {
            color: #ffd166;
        }

        .hero {
            background: #e4e9ff;
            text-align: center;
            padding: 65px 20px;
        }

        .hero h2 {
            font-size: 38px;
            color: #263b80;
            margin-bottom: 15px;
        }

        .hero p {
            max-width: 650px;
            margin: 0 auto 20px;
        }

        .button {
            display: inline-block;
            background: #405de6;
            color: white;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 6px;
        }

        .cards {
            max-width: 1100px;
            margin: 35px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
        }

        .card h3 {
            color: #263b80;
            margin-bottom: 10px;
        }

        footer {
            background: #263b80;
            color: white;
            text-align: center;
            padding: 20px;
        }

        @media (max-width: 768px) {
            header {
                flex-direction: column;
                text-align: center;
            }

            nav {
                justify-content: center;
            }

            .cards {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .hero h2 {
                font-size: 30px;
            }
        }

        @media (max-width: 500px) {
            .cards {
                grid-template-columns: 1fr;
            }

            .hero h2 {
                font-size: 26px;
            }

            nav {
                gap: 12px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>My Website</h1>

        <nav>
            <a href="#home">Home</a>
            <a href="#services">Services</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <section class="hero" id="home">
        <h2>Welcome to My Website</h2>
        <p>
            This responsive webpage automatically adjusts its layout
            to different screen sizes using CSS media queries and Grid.
        </p>
        <a href="#services" class="button">Explore Services</a>
    </section>

    <main class="cards" id="services">

        <article class="card">
            <h3>Web Design</h3>
            <p>Learn how to create attractive and user-friendly websites.</p>
        </article>

        <article class="card">
            <h3>Development</h3>
            <p>Build useful websites using HTML, CSS, and JavaScript.</p>
        </article>

        <article class="card">
            <h3>Responsive Design</h3>
            <p>Make websites work on mobiles, tablets, and computers.</p>
        </article>

    </main>

    <footer id="contact">
        <p>&copy; 2026 My Website. All rights reserved.</p>
    </footer>

</body>
</html>
