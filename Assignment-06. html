<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Navigation Menu</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6fb;
        }

        .navbar {
            background: #243b80;
            color: white;
            padding: 18px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
        }

        .menu {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        .menu a {
            color: white;
            text-decoration: none;
            font-size: 16px;
            transition: 0.3s;
        }

        .menu a:hover {
            color: #ffd166;
        }

        .hero {
            text-align: center;
            padding: 100px 20px;
        }

        .hero h1 {
            font-size: 38px;
            color: #243b80;
            margin-bottom: 15px;
        }

        .hero p {
            color: #555;
            font-size: 18px;
            line-height: 1.6;
        }

        @media (max-width: 600px) {
            .navbar {
                flex-direction: column;
                gap: 20px;
            }

            .menu {
                justify-content: center;
                flex-wrap: wrap;
                gap: 15px;
            }

            .menu a {
                font-size: 14px;
            }

            .hero {
                padding: 65px 20px;
            }

            .hero h1 {
                font-size: 28px;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">

        <div class="logo">MyWebsite</div>

        <ul class="menu">
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>

    </nav>

    <section class="hero" id="home">
        <h1>Welcome to My Website</h1>

        <p>
            Explore our website and discover useful information
            about our services and projects.
        </p>
    </section>

</body>
</html>
