<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creative Landing Page</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            color: #222;
            line-height: 1.6;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 7%;
            background: white;
            flex-wrap: wrap;
            gap: 15px;
        }

        .logo {
            color: #5b4bdb;
            font-size: 25px;
            font-weight: bold;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            gap: 22px;
        }

        nav a {
            color: #333;
            text-decoration: none;
        }

        nav a:hover {
            color: #5b4bdb;
        }

        .hero {
            min-height: 480px;
            padding: 70px 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
            background: linear-gradient(135deg, #eeedff, #e0f5ff);
        }

        .hero-content {
            flex: 1;
        }

        .hero h1 {
            color: #302477;
            font-size: 45px;
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .hero p {
            color: #555;
            margin-bottom: 25px;
            max-width: 500px;
        }

        .button {
            display: inline-block;
            background: #5b4bdb;
            color: white;
            text-decoration: none;
            padding: 13px 25px;
            border-radius: 7px;
            transition: 0.3s;
        }

        .button:hover {
            background: #302477;
            transform: translateY(-3px);
        }

        .hero-art {
            flex: 1;
            min-height: 250px;
            background: linear-gradient(135deg, #5b4bdb, #24a8c7);
            color: white;
            border-radius: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 30px;
            font-size: 32px;
            font-weight: bold;
        }

        .features {
            padding: 55px 7%;
            text-align: center;
        }

        .features h2 {
            color: #302477;
            margin-bottom: 30px;
            font-size: 30px;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 25px;
        }

        .feature {
            padding: 25px;
            border-radius: 12px;
            background: #f8f8ff;
            border: 1px solid #e7e5ff;
        }

        .feature h3 {
            color: #5b4bdb;
            margin-bottom: 10px;
        }

        footer {
            background: #302477;
            color: white;
            text-align: center;
            padding: 20px;
        }

        @media (max-width: 700px) {
            header {
                flex-direction: column;
            }

            nav {
                justify-content: center;
            }

            .hero {
                flex-direction: column;
                text-align: center;
                padding: 50px 6%;
            }

            .hero h1 {
                font-size: 34px;
            }

            .hero p {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-art {
                width: 100%;
                min-height: 200px;
                font-size: 27px;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">CreativeSpace</div>

        <nav>
            <a href="#home">Home</a>
            <a href="#features">Features</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <main>
        <section class="hero" id="home">

            <div class="hero-content">
                <h1>Turn Your Ideas Into Reality</h1>

                <p>
                    Discover new possibilities, learn valuable skills,
                    and bring your creative ideas to life with us.
                </p>

                <a href="#features" class="button">Get Started</a>
            </div>

            <div class="hero-art" id="about">
                Think.<br>Create.<br>Achieve.
            </div>

        </section>

        <section class="features" id="features">
            <h2>Why Choose Us?</h2>

            <div class="feature-grid">

                <article class="feature">
                    <h3>Creative Ideas</h3>
                    <p>Explore fresh ideas and develop your creativity.</p>
                </article>

                <article class="feature">
                    <h3>Easy Learning</h3>
                    <p>Learn new skills through simple and practical projects.</p>
                </article>

                <article class="feature">
                    <h3>Better Results</h3>
                    <p>Take meaningful steps toward achieving your goals.</p>
                </article>

            </div>
        </section>
    </main>

    <footer id="contact">
        <p>&copy; 2026 CreativeSpace. All rights reserved.</p>
    </footer>

</body>
</html>
