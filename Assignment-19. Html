<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JavaScript Mini Projects</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f0f4ff;
            margin: 0;
            padding: 25px;
        }

        header {
            text-align: center;
            color: #3730a3;
            margin-bottom: 30px;
        }

        .projects {
            max-width: 900px;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 25px;
        }

        .project {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        h2 {
            color: #4f46e5;
        }

        label {
            display: block;
            margin-top: 12px;
        }

        input {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            background: #4f46e5;
            color: white;
            border: none;
            padding: 11px 15px;
            border-radius: 5px;
            margin-top: 18px;
            cursor: pointer;
        }

        button:hover {
            background: #3730a3;
        }

        .output {
            margin-top: 15px;
            background: #eef2ff;
            padding: 12px;
            border-radius: 5px;
            line-height: 1.8;
            overflow-wrap: anywhere;
        }

        @media (max-width: 650px) {
            .projects {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>JavaScript Mini Projects</h1>
        <p>Grade Calculator and Multiplication Table</p>
    </header>

    <main class="projects">

        <section class="project">
            <h2>Mini Project 1: Grade Calculator</h2>

            <form id="gradeForm">
                <label for="subject1">Subject 1 Marks</label>
                <input type="number" id="subject1" min="0" max="100" required>

                <label for="subject2">Subject 2 Marks</label>
                <input type="number" id="subject2" min="0" max="100" required>

                <label for="subject3">Subject 3 Marks</label>
                <input type="number" id="subject3" min="0" max="100" required>

                <button type="submit">Calculate Grade</button>
            </form>

            <div class="output" id="gradeResult" aria-live="polite">
                Your grade will appear here.
            </div>
        </section>

        <section class="project">
            <h2>Mini Project 2: Multiplication Table</h2>

            <label for="tableNumber">Enter a Number</label>
            <input type="number" id="tableNumber" min="1" max="100" value="5">

            <button type="button" id="tableButton">Generate Table</button>

            <div class="output" id="tableResult" aria-live="polite">
                Your multiplication table will appear here.
            </div>
        </section>

    </main>

    <script>
        // Mini Project 1: Grade Calculator
        document.getElementById("gradeForm")
            .addEventListener("submit", function(event) {

            event.preventDefault();

            const marks = [
                Number(document.getElementById("subject1").value),
                Number(document.getElementById("subject2").value),
                Number(document.getElementById("subject3").value)
            ];

            const result = document.getElementById("gradeResult");

            if (marks.some(mark => mark < 0 || mark > 100)) {
                result.textContent = "Enter marks between 0 and 100.";
                return;
            }

            const total = marks.reduce((sum, mark) => sum + mark, 0);
            const percentage = total / marks.length;

            let grade;

            if (marks.some(mark => mark < 33)) {
                grade = "F - Fail";
            } else if (percentage >= 90) {
                grade = "A+";
            } else if (percentage >= 80) {
                grade = "A";
            } else if (percentage >= 70) {
                grade = "B";
            } else if (percentage >= 60) {
                grade = "C";
            } else {
                grade = "D - Pass";
            }

            result.textContent =
                "Total: " + total + " / 300 | " +
                "Percentage: " + percentage.toFixed(2) + "% | " +
                "Grade: " + grade;
        });

        // Mini Project 2: Multiplication Table
        document.getElementById("tableButton")
            .addEventListener("click", function() {

            const number = Number(
                document.getElementById("tableNumber").value
            );

            const result = document.getElementById("tableResult");

            if (!Number.isInteger(number) || number < 1 || number > 100) {
                result.textContent = "Enter a whole number from 1 to 100.";
                return;
            }

            const lines = [];

            for (let i = 1; i <= 10; i++) {
                lines.push(number + " × " + i + " = " + number * i);
            }

            result.textContent = lines.join(" | ");
        });
    </script>

</body>
</html>
